{
  "project_files": {
    ".structuredmerge/git-drivers.toml": "version = 1\n",
    ".gitattributes": "*.md diff=markdown\n"
  },
  "request": {
    "profile": "semantic-diff",
    "scope": "local",
    "mode": "plan"
  },
  "drivers": [
    {
      "language": "ruby",
      "pattern": "*.rb",
      "diff": "smorg-rb",
      "merge": "smorg-rb",
      "command": "smorg-rb diff-driver"
    }
  ]
}

